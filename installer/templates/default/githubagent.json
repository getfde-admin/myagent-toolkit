{
  "name": "Default",
  "tagline": "Agent default template (Pi Coding Agent) — defaults to OpenRouter / DeepSeek V4 Flash",
  "description": "Agent default template, now powered by Pi Coding Agent. Each Agent (GitHub Issue) can pick its own provider and model, with API keys managed per provider. Defaults to OpenRouter and DeepSeek V4 Flash, while preserving the multi-provider lineup: Cloudflare, Anthropic, OpenAI, Gemini, Groq, OpenRouter, and Ollama Cloud.",
  "category": "ai",
  "tags": ["default", "pi", "byok", "cloudflare", "anthropic", "openai", "gemini", "groq", "openrouter", "ollama"],
  "version": "1.0.0",
  "support_url": "https://github.com/getfde-admin/myagent-toolkit/issues",
  "homepage": "https://github.com/getfde-admin/myagent-toolkit",
  "byokFlow": true,
  "byokConfig": {
    "path": ".pi/settings.json",
    "providerField": "defaultProvider",
    "modelField": "defaultModel",
    "merge": true
  },
  "providers": [
    {
      "id": "google",
      "label": "Google Gemini",
      "description": "Use Google Gemini family models. Requires GEMINI_API_KEY.",
      "secretName": "GEMINI_API_KEY",
      "defaultModel": "gemini-3.5-flash",
      "models": [
        { "value": "gemini-3.5-flash",             "label": "Gemini 3.5 Flash ⭐" },
        { "value": "gemini-3.5-pro",               "label": "Gemini 3.5 Pro" },
        { "value": "gemini-3.1-pro",               "label": "Gemini 3.1 Pro" },
        { "value": "gemini-3.1-flash-lite-preview", "label": "Gemini 3.1 Flash Lite (Preview)" },
        { "value": "gemini-3-flash-preview",        "label": "Gemini 3 Flash (Preview)" },
        { "value": "gemini-3-pro-preview",          "label": "Gemini 3 Pro (Preview)" },
        { "value": "gemini-2.5-pro",               "label": "Gemini 2.5 Pro (legacy)" },
        { "value": "gemini-2.5-flash",             "label": "Gemini 2.5 Flash (legacy)" },
        { "value": "gemini-2.0-flash",             "label": "Gemini 2.0 Flash (legacy)" }
      ]
    },
    {
      "id": "anthropic",
      "label": "Anthropic",
